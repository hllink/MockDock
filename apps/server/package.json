{
  "name": "@mockdock/server",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @mockdock/shared build && pnpm --filter @mockdock/route-inference build && vitest run"
  },
  "dependencies": {
    "@mockdock/route-inference": "workspace:*",
    "@mockdock/shared": "workspace:*",
    "@libsql/client": "^0.15.15",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.3.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "5.8.3",
    "vitest": "^3.2.4"
  }
}
